# Folder musik yang akan di-scan (path absolut Windows / Linux)
MUSIC_DIR=./music

# Folder runtime data aplikasi (artwork & transcode cache)
DATA_DIR=./data

# MySQL Database
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=music_nest

# Izinkan dev-server diakses dari origin/IP lain di jaringan lokal (comma-separated, opsional)
# Contoh: 192.168.1.*, 10.0.0.*
ALLOWED_DEV_ORIGINS=
